# Preferred location: qq-ai-bridge/.env
# Fallback location also supported: ../.env (repo root)
# Vision API endpoint, e.g. OpenAI-compatible /v1/chat/completions
VISION_API_URL=https://api.moonshot.cn/v1/chat/completions
# Keep secret, bridge startup log will only print set/missing
VISION_API_KEY=your_api_key_here
# Must be a model with image/vision capability
VISION_MODEL=kimi-k2.6

# QQ / NapCat
NAPCAT_HTTP=http://127.0.0.1:3001
NAPCAT_TOKEN=hajimi
ALLOWED_PRIVATE_USER=273007866
OWNER_QQ=273007866
OWNER_NAME=Candace
AI_CMD=/home/cancade/.local/bin/ocai

# Scheduler
SCHEDULER_TICK_SECONDS=15
SLEEP_REMINDER_TIME=01:30
TOMORROW_SCHEDULE_TIME=23:30
SLEEP_REMINDER_TEXT=该睡觉了，别熬太晚。
PRIVATE_CONTEXT_WINDOW_SECONDS=1800
PRIVATE_CONTEXT_SOFT_LIMIT_SECONDS=3600
PRIVATE_COMPACT_MAX_TURNS=2
PRIVATE_COMPACT_MAX_CHARS=400
DEFAULT_WEATHER_LOCATION=Zhuhai
WEATHER_API_TIMEOUT_SECONDS=8
WEATHER_ENABLE_LLM_LOCATION_FALLBACK=true

# Quick local testing: set to minutes after service startup, 0 means disabled
SLEEP_REMINDER_TEST_DELAY_MINUTES=0
TOMORROW_SCHEDULE_TEST_DELAY_MINUTES=0

# --- Secrets: do not commit real values. Prefer machine-local file: ~/.candace/qq-ai-bridge.env
# (or qq-ai-bridge/.local.env). See docs/install/run.md.

# VoCat (optional)
VOCAT_WEBHOOK_TOKEN=
VOCAT_API_TOKEN=
VOCAT_EXPRESSION_API_URL=
VOCAT_TTS_API_URL=
VOCAT_INSTANCE_ID=
VOCAT_PRODUCT_KEY=
VOCAT_DEVICE_NAME=
VOCAT_BOT_ID=
VOCAT_QQ_FORWARD_USER_ID=
VOCAT_VOICE_REPLY_TO_QQ=true
VOCAT_QQ_REPLY_TO_DEVICE=true
VOCAT_DAILY_BROADCAST_TO_DEVICE=true
VOCAT_COMMAND_QUEUE_MAX=50
VOCAT_TRUSTED_DEVICE_IPS=192.168.110.200
VOCAT_REMOTE_CONTROL_USERS=
VOCAT_QQ_KEYWORDS=qq,QQ,发QQ,转发QQ,告诉QQ

# LLM (browser loop / shared; optional)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Browser agent (optional)
BROWSER_AGENT_HTTP_TIMEOUT_SECONDS=12
PC_BROWSER_AGENT_URL=http://127.0.0.1:5050
