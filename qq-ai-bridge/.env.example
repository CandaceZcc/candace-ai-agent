# Preferred location: qq-ai-bridge/.env
# Fallback location also supported: ../.env (repo root)
# RightCodes Gemini native generateContent endpoint
VISION_API_URL=https://right.codes/gemini/v1beta/models/gemini-3-flash-preview:generateContent
# Keep secret, bridge startup log will only print set/missing
VISION_API_KEY=
VISION_MODEL=gemini-3-flash-preview

# QQ / NapCat
NAPCAT_HTTP=http://127.0.0.1:3001
NAPCAT_TOKEN=hajimi
ALLOWED_PRIVATE_USER=273007866
OWNER_QQ=273007866
OWNER_NAME=Candace
AI_CMD=/home/cancade/.local/bin/ocai

# Scheduler
SCHEDULER_TICK_SECONDS=15
SLEEP_REMINDER_TIME=01:30
TOMORROW_SCHEDULE_TIME=23:30
SLEEP_REMINDER_TEXT=该睡觉了，别熬太晚。
PRIVATE_CONTEXT_WINDOW_SECONDS=1800
PRIVATE_CONTEXT_SOFT_LIMIT_SECONDS=3600
PRIVATE_COMPACT_MAX_TURNS=2
PRIVATE_COMPACT_MAX_CHARS=400
DEFAULT_WEATHER_LOCATION=Zhuhai
WEATHER_API_TIMEOUT_SECONDS=8
WEATHER_ENABLE_LLM_LOCATION_FALLBACK=true

# Quick local testing: set to minutes after service startup, 0 means disabled
SLEEP_REMINDER_TEST_DELAY_MINUTES=0
TOMORROW_SCHEDULE_TEST_DELAY_MINUTES=0

# --- Secrets: do not commit real values. Prefer machine-local file: ~/.candace/qq-ai-bridge.env
# (or qq-ai-bridge/.local.env). See docs/install/run.md.

# VoCat (optional)
VOCAT_WEBHOOK_TOKEN=
VOCAT_API_TOKEN=
VOCAT_EXPRESSION_API_URL=
VOCAT_TTS_API_URL=
VOCAT_INSTANCE_ID=
VOCAT_PRODUCT_KEY=
VOCAT_DEVICE_NAME=
VOCAT_BOT_ID=
VOCAT_QQ_FORWARD_USER_ID=
VOCAT_VOICE_REPLY_TO_QQ=true
VOCAT_QQ_REPLY_TO_DEVICE=true
VOCAT_DAILY_BROADCAST_TO_DEVICE=true
VOCAT_COMMAND_QUEUE_MAX=50
VOCAT_TRUSTED_DEVICE_IPS=192.168.110.200
VOCAT_REMOTE_CONTROL_USERS=
VOCAT_QQ_KEYWORDS=qq,QQ,发QQ,转发QQ,告诉QQ

# LLM (browser loop / shared; optional)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.deepseek.com
KIMI_MODEL=deepseek-v4-flash
LLM_BACKEND=auto
LLM_MAX_CONCURRENCY=4
LLM_QUEUE_TIMEOUT_SECONDS=1

# Bounded background work and lifecycle cleanup
RUNTIME_CHAT_WORKERS=8
RUNTIME_CHAT_MAX_PENDING=64
RUNTIME_MEDIA_WORKERS=2
RUNTIME_MEDIA_MAX_PENDING=8
RUNTIME_SCHEDULED_MAX_PENDING=256
CHAT_STATE_TTL_SECONDS=1800
IMAGE_CAPTION_PENDING_MAX=128
IMAGE_TMP_MAX_AGE_SECONDS=259200
IMAGE_TMP_MAX_BYTES=536870912
BRIDGE_LOG_MAX_BYTES=20971520
BRIDGE_LOG_BACKUP_COUNT=7
BRIDGE_LOG_BACKUP_MAX_AGE_SECONDS=1209600
BRIDGE_LOG_BACKUP_MAX_BYTES=146800640

# Image generation (/draw); DRAW_API_KEY falls back to VISION_API_KEY
DRAW_API_KEY=
DRAW_BASE_URL=https://www.right.codes
DRAW_MODEL=nano-banana-2
DRAW_ASPECT_RATIO=1:1
DRAW_IMAGE_SIZE=1K
DRAW_POLL_INTERVAL_SECONDS=2
DRAW_TIMEOUT_SECONDS=240
DRAW_POLL_MAX_TRANSIENT_ERRORS=6
DRAW_FALLBACK_MODEL=gpt-image-2
DRAW_FALLBACK_ENABLED=true

# Browser agent (optional)
BROWSER_AGENT_HTTP_TIMEOUT_SECONDS=12
PC_BROWSER_AGENT_URL=http://127.0.0.1:5050
